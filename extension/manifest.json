{
  "manifest_version": 3,
  "name": "Notion Page Navigator",
  "version": "1.2.0",
  "permissions": ["storage"],
  "description": "Notionのページに見出し一覧・リンク先・リンク元のペインと、行番号・コードブロックの行番号・見出しの縦棒を追加します。",
  "content_scripts": [
    {
      "matches": ["https://www.notion.so/*", "https://notion.so/*", "https://app.notion.com/*"],
      "js": [
        "core.js",
        "notion-dom.js",
        "notion-records.js",
        "notion-api.js",
        "page-structure.js",
        "backlinks.js",
        "page-data.js",
        "settings.js",
        "decoration-style.js",
        "code-numbers.js",
        "wide-blocks.js",
        "decorations.js",
        "panel-style.js",
        "ui-elements.js",
        "pane-view.js",
        "toolbar.js",
        "jump-top.js",
        "page-snapshot.js",
        "outline-navigation.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Notion Page Navigator の設定",
    "default_popup": "popup.html"
  }
}
